{
  "expo": {
    "name": "Dust Monitoring System",
    "slug": "dms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/DMS_LOGO.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.company.dms",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/DMS_LOGO.png",
        "backgroundImage": "./assets/images/DMS_LOGO.png",
        "monochromeImage": "./assets/images/DMS_LOGO.png"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.company.dms"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/DMS_LOGO.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#E6F4FE",
          "dark": {
            "image": "./assets/images/DMS_LOGO.png",
            "imageWidth": 300,
            "resizeMode": "contain",
            "backgroundColor": "#1A1A2E"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "35e1c3d9-dc4a-43e2-be8b-104e4b5fdd60"
      }
    }
  }
}
